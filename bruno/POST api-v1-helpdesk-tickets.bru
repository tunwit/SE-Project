meta {
  name: post /api/v1/helpdesk/tickets
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/helpdesk/tickets
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Cannot sign in to KU All Login",
    "typeOfProblem": "KU All Login",
    "description": "Caller reports a password error.",
    "tel": "0812345678",
    "refSender": "Phone"
  }
}

docs {
  Creates a ticket as HELPDESK or ADMIN. Required fields: title, typeOfProblem, description and tel. Optional refSender. Returns 201 with data.displayId. Multipart form may include up to five image files (JPEG, PNG or WebP; each at most 10 MB).
}
