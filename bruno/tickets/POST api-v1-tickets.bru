meta {
  name: post /api/v1/tickets
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/tickets
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Cannot sign in to KU All Login",
    "typeOfProblem": "KU All Login",
    "description": "The system says the password is incorrect.",
    "tel": "0812345678",
    "refSender": ""
  }
}

docs {
  Creates a requester ticket. Required: title, typeOfProblem matching a category, description, tel. Optional refSender. Returns 201 with data.displayId. For attachments use multipart/form-data with the same fields and up to five image files (JPEG, PNG or WebP; each at most 10 MB).
}
