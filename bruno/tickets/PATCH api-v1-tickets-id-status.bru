meta {
  name: patch /api/v1/tickets/:id/status
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/v1/tickets/{{displayID}}/status
  body: none
  auth: inherit
}

docs {
  Advances a ticket assigned to the current HELPDESK user: OPEN to IN_PROGRESS to CLOSED. id is displayID, not the UUID. No request body. Returns 409 when already CLOSED.
}
